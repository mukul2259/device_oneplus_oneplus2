cc_library_static {
    name: "libinit_oneplus2",
    recovery_available: true,
    srcs: ["init_oneplus2.cpp"],
    include_dirs: [
        "system/libbase/include",
        "system/core/init"
    ]
}

prebuilt_etc {
     name: "fstab.qcom",
     src: "fstab.qcom",
     soc_specific: true,
     ramdisk_available: true,
 }
 
 prebuilt_etc {
     name: "init.qcom.power.rc",
     src: "init.qcom.power.rc",
     sub_dir: "init/hw",
     soc_specific: true,
 }
 
 prebuilt_etc {
     name: "init.qcom.rc",
     src: "init.qcom.rc",
     sub_dir: "init/hw",
     soc_specific: true,
 }
 
 prebuilt_etc {
     name: "init.qcom.usb.rc",
     src: "init.qcom.usb.rc",
     sub_dir: "init/hw",
     soc_specific: true,
 }
 
 prebuilt_etc {
     name: "init.qcom.recovery.rc",
     src: "init.qcom.recovery.rc",
     sub_dir: "init",
     recovery: true,
 }
 
 prebuilt_etc {
     name: "ueventd.qcom.rc",
     filename: "ueventd.rc",
     src: "ueventd.qcom.rc",
     soc_specific: true,
 }
 
 sh_binary {
     name: "init.oneplus2.power.sh",
     src: "init.oneplus2.power.sh",
     soc_specific: true,
 }
 
 sh_binary {
     name: "init.tfa.sh",
     src: "init.tfa.sh",
     soc_specific: true,
 }
 
 sh_binary {
     name: "init.qcom.bt.sh",
     src: "init.qcom.bt.sh",
     soc_specific: true,
 }
 
 sh_binary {
     name: "init.qcom.sh",
     src: "init.qcom.sh",
     soc_specific: true,
 }
 
 sh_binary {
     name: "init.qcom.usb.sh",
     src: "init.qcom.usb.sh",
     soc_specific: true,
 }
 
 sh_binary {
     name: "init.program_bdaddr.sh",
     src: "init.program_bdaddr.sh",
     soc_specific: true,
 }
 
 sh_binary {
     name: "wifi-hal.sh",
     src: "wifi-hal.sh",
     soc_specific: true,
 }
