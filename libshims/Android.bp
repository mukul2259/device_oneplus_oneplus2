cc_library_shared {
    name: "rild_socket",
    srcs: ["rild_socket.c"],
    vendor: true,
}

cc_library_shared {
    name: "libshim_atomic",
    srcs: ["atomic.cpp"],
    vendor: true,
    header_libs: ["libcutils_headers"],
}

cc_library_shared {
    name: "libaudioclient_shim.msm8994",
    srcs: ["libaudioclient_shim.cpp"],
    shared_libs: ["libaudioclient"],
}

cc_library_shared {
    name: "libshims_ims",
    srcs: ["libshim_mediabuffer.cpp"],
    shared_libs: [
        "libstagefright_foundation",
        "libui",
        "libgui",
        "libmedia",
    ],
    compile_multilib: "64",
}

cc_library_shared {
    name: "libshims_postproc",
    srcs: ["libshims_postproc.cpp"],
    cflags: ["-Wno-unused-parameter"],
    vendor: true,
}

cc_library_shared {
    name: "lib-imsvtshim",
    srcs: ["lib-imsvtshim.cpp"],
}

// Pull system libraries used by legacy vendor daemons (netmgrd,
// imsdatadaemon) into the vendor linker namespace. These libs are
// vendor_available, so linking them from this vendor module installs them
// to the vendor partition where the blobs can find them.
cc_library_shared {
    name: "liboneplus2_vendor_compat",
    vendor: true,
    srcs: ["libnetutils_pull.cpp"],
    shared_libs: [
        "libnetutils",
        "libhwbinder",
        "libhidlbase",
        "libhidltransport",
        "libpower",
    ],
    compile_multilib: "both",
}
